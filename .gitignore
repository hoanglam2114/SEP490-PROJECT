# ══════════════════════════════════════════════
#  .gitignore — SEP490 Monorepo
#  Đặt file này ở ROOT của project
# ══════════════════════════════════════════════

# ── ENV FILES (QUAN TRỌNG NHẤT) ───────────────
.env
.env.*
!.env.example        # chỉ cho phép file mẫu (không có key thật)
*.env
gpu_service.env
backend/.env
gpu_service/.env

# ── Node.js ───────────────────────────────────
node_modules/
dist/
build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
venv/
env/
.venv/
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
.eggs/

# ── Frontend build ────────────────────────────
frontend/dist/
frontend/.vite/

# ── TypeScript ────────────────────────────────
*.tsbuildinfo
ts_errors.txt
tsc_output.txt
build_err.txt
build_output.txt

# ── ML / AI artifacts ─────────────────────────
checkpoints/
*.ckpt
*.safetensors
*.bin
*.pt
*.pth
dataset_uploads/
/tmp/checkpoints/

# ── Credentials & secrets ─────────────────────
*.pem
*.key
*.p12
*.pfx
service_account*.json
*credentials*.json
google_credentials.json

# ── Docker ────────────────────────────────────
# (giữ lại Dockerfile và docker-compose.yml)
.docker/

# ── OS ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs ──────────────────────────────────────
logs/
*.log

# ── Uploads (dữ liệu người dùng) ──────────────
uploads/

build_err.txt
build_output.txt
ts_errors.txt
tsc_output.txt
errors.txt
